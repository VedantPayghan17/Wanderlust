<% layout("/layouts/boilerplate") %>
    <div class="row mt-4">
        <div class="col-8 offset-2">
            <h2>Create new Listings</h2>
            <form action="/listings" method="POST" novalidate class="needs-validation">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" class="form-control" placeholder="enter catchy title" name="listing[title]" class="form-control" required> 
                    <div class="valid-feedback">The title looks good!</div>
                </div>
                <div class="mb-3">
                    <label for="desc" class="form-label">Description</label>
                    <textarea class="form-control" name="listing[desc]" placeholder="enter description" rows="3 "
                        cols="10"  required></textarea> 
                </div><br>

                <div class="mb-3">
                    <label for="listingimage" class="form-label">Image URL</label>
                    <input type="text" placeholder="enter img url" class="form-control"
                        name="listing[listingimage]">
                </div><br>

                <div class="row ">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input type="text" placeholder="price" class="form-control"  name="listing[price]" required> 
                        <!-- <div class="invalid-feedback">please enter correct price</div> -->
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input type="text" placeholder="enter country"  name="listing[country]" 
                            class="form-control" required> 
                    </div><br>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
 <input type="text"  name="listing[location]" placeholder="enter location"
                        class="form-control" required> 
                </div><br>
                <button class="btn btn-dark">ADD</button>

                <form>
        </div>
    </div>

    </form>